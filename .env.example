# Copie este arquivo para ".env" e preencha com seus valores.

# Provedor de LLM externa usado na etapa de GERAÇÃO da resposta: "groq" ou "openai"
LLM_PROVIDER=groq

# --- Groq (recomendado: possui tier gratuito) ---
# Crie sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=coloque_sua_chave_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant

# --- OpenAI (alternativa) ---
# OPENAI_API_KEY=coloque_sua_chave_openai_aqui
# OPENAI_MODEL=gpt-4o-mini

# --- Parâmetros opcionais do pipeline de RAG ---
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MAX_HISTORY_TURNS=4
